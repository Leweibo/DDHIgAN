{
  "dates_prohibited": true,
  "identifier_fields_prohibited": true,
  "max_visits": 30,
  "query_must_equal_last_actual_visit": true,
  "requires_t0_anchor": true,
  "schema_version": "1.0",
  "sex_encoding": {
    "female": 1,
    "male": 0
  },
  "time_encoding": "inter-visit years divided by 10",
  "transform": "ln(PRO24H + 0.001)",
  "units": {
    "albumin": "g/L",
    "creatinine": "mg/dL",
    "cystatin_c": "mg/L",
    "proteinuria": "g/24 h"
  }
}
